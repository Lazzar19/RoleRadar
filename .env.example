# Copy to .env and edit before `docker compose up`. Never commit .env.

# --- Database and HTTP (app container) ---
# Required when running the binary directly. Compose sets this for the app service.
DATABASE_URL=postgres://scout:scout@postgres:5432/scout?sslmode=disable
PORT=8080

# --- Docker Compose (Postgres and backup services only) ---
# Default matches compose.yaml. Change before the host is reachable by others.
POSTGRES_PASSWORD=scout

# --- Telegram (required for bot delivery) ---
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=
# Optional reverse proxy or Bot API mirror (default https://api.telegram.org)
TELEGRAM_API_BASE=

# --- Job sources ---
# JSON array of sources; see docs/configuration.md and README “Sources”.
# SOURCES=[{"name":"example","type":"greenhouse","board_token":"example","enabled":true}]
SOURCES=

# IMAP URL for LinkedIn alert email (used when an enabled email source references it)
MAILBOX_URL=

# Public API bases (defaults shown)
GREENHOUSE_API_BASE=https://boards-api.greenhouse.io
LEVER_API_BASE=https://api.lever.co

# Poll cadence (Go duration syntax)
GREENHOUSE_INTERVAL=1h
GREENHOUSE_JITTER=10m
MAILBOX_INTERVAL=5m
MAILBOX_JITTER=1m
CAREER_INTERVAL=6h
CAREER_JITTER=30m

# --- Queue workers ---
WORKER_COUNT=1
TASK_TIMEOUT=2m
TASK_MAX_ATTEMPTS=5
WORKER_POLL_INTERVAL=2s
TASK_RETRY_BASE=5s

# --- Rule-based matching ---
MATCH_WEIGHT_ROLE=30
MATCH_WEIGHT_SKILLS=30
MATCH_WEIGHT_EXPERIENCE=20
MATCH_WEIGHT_LOCATION=10
MATCH_WEIGHT_COMPANY=10
MATCH_THRESHOLD=70

# --- Optional LLM fact extraction (OpenAI-compatible) ---
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EXTRACT_MIN_CHARS=80
EXTRACT_MAX_CHARS=12000
# Daily token budget per UTC day; 0 disables the cap
EXTRACT_DAILY_TOKENS=200000

# --- Telegram notification kinds ---
NOTIFY_PREVIEW=true
NOTIFY_EVALUATED=true

# --- Weight comparison CLI (`go run . compare`) ---
# Set at least one PROPOSED_* variable to compare against labeled feedback.
# PROPOSED_MATCH_THRESHOLD=80
# PROPOSED_MATCH_WEIGHT_ROLE=30